# Supabase member authentication
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Canonical production origin used in confirmation and password-reset links.
DASHBOARD_PUBLIC_URL=
# Optional. Defaults to the bootstrap admin email.
DASHBOARD_APPROVAL_EMAIL=

# Existing dashboard integrations
BRAND_FINDER_GMAIL_CLIENT_ID=
BRAND_FINDER_GMAIL_CLIENT_SECRET=
BRAND_FINDER_GMAIL_REFRESH_TOKEN=
WEEKLY_GMAIL_READONLY_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
TEAM_ASSETS_SPREADSHEET_ID=

# Durable Bulk Follow-up queue and authentication rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# Keep Follow-up draft creation blocked in Preview by default.
ALLOW_PREVIEW_BULK_FOLLOW_UP=false

# Calendly notifications fail closed until this is configured on both sides.
CALENDLY_WEBHOOK_SECRET=
